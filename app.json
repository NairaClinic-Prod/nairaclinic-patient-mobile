{
  "expo": {
    "name": "Nairaclinic Patient Mobile",
    "slug": "nairaclinic-patient-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "nairaclinic-patient-mobile",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "NairaClinic uses your camera so your doctor can see you during a video consultation.",
        "NSMicrophoneUsageDescription": "NairaClinic uses your microphone so your doctor can hear you during a consultation.",
        "NSBluetoothAlwaysUsageDescription": "NairaClinic uses Bluetooth so you can use headphones during a consultation.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      },
      "bundleIdentifier": "com.jay-tech.nairaclinic-patient-mobile",
      "appleTeamId": "94324ZRMM3"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#f6f8f5"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.WAKE_LOCK"
      ],
      "package": "com.jaytech.nairaclinicpatientmobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "NairaClinic uses your photos so you can choose a profile picture.",
          "cameraPermission": "NairaClinic uses your camera so you can take a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NairaClinic uses your location to find pharmacies and laboratories close to you."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "NairaClinic adds your medicine and care reminders to your calendar so you never miss one."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f6f8f5",
          "dark": {
            "image": "./assets/images/logo.png",
            "backgroundColor": "#0b1411"
          }
        }
      ],
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "NairaClinic uses Face ID to keep your health records locked."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "NairaClinic uses Face ID so you can open the app without typing your PIN."
        }
      ],
      "expo-sharing",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
