+RCT_EXPORT_METHOD(setVideoQualityPreference:(NSDictionary *)setting
+                  withResolve:(RCTPromiseResolveBlock)resolve
+                  withRejecter:(RCTPromiseRejectBlock)reject)
+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        ZoomVideoSDKVideoPreferenceSetting *preference = [[ZoomVideoSDKVideoPreferenceSetting alloc] init];
+        id mode = [setting objectForKey:@"mode"];
+        preference.mode = mode ? [RCTConvert ZoomVideoSDKVideoPreferenceMode:mode] : ZoomVideoSDKVideoPreferenceMode_Balance;
+        preference.minimumFrameRate = [[setting objectForKey:@"minimumFrameRate"] unsignedIntegerValue];
+        preference.maximumFrameRate = [[setting objectForKey:@"maximumFrameRate"] unsignedIntegerValue];
+        resolve([[RCTConvert ZoomVideoSDKErrorValuesReversed] objectForKey: @([[self getVideoHelper] setVideoQualityPreference:preference])]);
+    });
+}
